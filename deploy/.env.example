# Gere o deploy/.env com: ./init-env.sh <domínio-do-site> <seu-email> [email-do-editor]
# (ou copie este arquivo e preencha; segredos: openssl rand -hex 32)

# Domínio público do site (canonical, sitemap, hreflang)
VITE_SITE_URL=https://albani.kaedai.com.br

# Directus (servido em <domínio>/cms pelo nginx; o painel abre em <domínio>/admin)
DIRECTUS_KEY=
DIRECTUS_SECRET=
CMS_PUBLIC_URL=https://albani.kaedai.com.br/cms

# Primeiro administrador (você). Criado só na primeira subida do Directus.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Token de leitura usado pelo build (o setup.mjs grava este valor no usuário "build")
BUILD_TOKEN=

# Segredo que o Flow do Directus envia ao builder no POST /rebuild
REBUILD_SECRET=

# Usuário do Dr. Ivan (perfil Editor). Opcional: se vazio, crie depois pelo admin.
EDITOR_EMAIL=
EDITOR_PASSWORD=

# Pasta do host servida pelo nginx (releases/ + symlink current)
SITE_ROOT=/var/www/albani
