# Copie para deploy/.env e preencha. Gere os segredos com: openssl rand -hex 32

# Directus
DIRECTUS_KEY=
DIRECTUS_SECRET=
CMS_PUBLIC_URL=https://cms.albaniadv.com

# Primeiro administrador (você). Criado só na primeira subida do Directus.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Token de leitura usado pelo build (o setup.mjs grava este valor no usuário "build")
BUILD_TOKEN=

# Segredo que o Flow do Directus envia ao builder no POST /rebuild
REBUILD_SECRET=

# Usuário do Dr. Ivan (perfil Editor). Opcional: se vazio, crie depois pelo admin.
EDITOR_EMAIL=
EDITOR_PASSWORD=

# Pasta do host servida pelo nginx (releases/ + symlink current)
SITE_ROOT=/var/www/albani
